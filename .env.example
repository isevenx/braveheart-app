# ─────────────────────────────────────────────────────────────────────────────
# Braveheart app settings. Copy to .env.local for local dev; add the same keys
# in Vercel → Project → Settings → Environment Variables for production.
# With DATABASE_URL or AUTH_GOOGLE_ID missing, the app runs in DEMO MODE
# (sample data, nothing saved).
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the app (used in email links)
APP_URL=http://localhost:3000

# Force demo mode on/off (optional)
# DEMO_MODE=true

# ── Database: PostgreSQL (Neon via the Vercel Marketplace is easiest) ─────────
DATABASE_URL=

# ── Sign-in (Auth.js) ────────────────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Email (Resend: sign-in links, confirmations, big-day emails) ─────────────
AUTH_RESEND_KEY=
# Must be on a domain verified in Resend, e.g. "Braveheart <book@braveheartpb.com>"
EMAIL_FROM=

# ── Shop calendars (Google service account) ─────────────────────────────────
# Create a service account, download its JSON key, and share each barber's
# Google Calendar with the service account email ("Make changes to events").
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The "private_key" value from the JSON key, with \n line breaks kept as-is
GOOGLE_SERVICE_ACCOUNT_KEY=
# Each barber's Google Calendar ID (Calendar settings → Integrate calendar)
CAL_JARED=
CAL_CAMILO=
CAL_BOOBI=
CAL_JOHN=

# ── AI big-day detection (Anthropic) ─────────────────────────────────────────
# Without a key, a simple keyword match is used instead.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# ── Push notifications (Web Push) ───────────────────────────────────────────
# Generate with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@braveheartpb.com

# ── Daily jobs (Vercel Cron sends this as a Bearer token) ────────────────────
# Any long random string, e.g. from: openssl rand -hex 32
CRON_SECRET=
